# ── Required ──────────────────────────────────────────────────────────────────

# Token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# High-entropy secret (≥32 chars) used to derive per-user wallet encryption keys.
# ⚠️  Keep this safe and backed up – losing it means losing access to all stored wallets.
BOT_MASTER_KEY=change-me-use-a-long-random-string-here

# ── Optional ─────────────────────────────────────────────────────────────────

# 1% fee recipient on Base (EVM).  Defaults to the owner's treasury.
# FEE_RECIPIENT_ADDRESS=0x5D47D3388504824408dBf8943fd6711fEF3cBEfe

# Base-network RPC endpoint.  Public endpoint is used by default.
# Use a private endpoint (Alchemy / QuickNode) for production reliability.
# BASE_RPC_URL=https://mainnet.base.org

# Path for the SQLite database file.
# When running in Docker, this is mounted at /app/data/bot_data.db.
# DATABASE_PATH=/app/data/bot_data.db
